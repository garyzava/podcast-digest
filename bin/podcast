#!/usr/bin/env bash
# CLI wrapper: podcast <shows|episodes|fetch|transcript|summarize> ...  (see `podcast --help`)
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONWARNINGS="${PYTHONWARNINGS:-ignore}"   # hide yt-dlp's Python-version deprecation warnings; harmless
exec uv run --quiet "$DIR/tools/podcast/podcast.py" "$@"
